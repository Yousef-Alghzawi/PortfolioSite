---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const page = {
  "title": "Thrombolysis After the Window Closes",
  "description": "Frequentist and Bayesian network meta-analysis of intravenous alteplase beyond 4.5 hours for ischemic stroke.",
  "field": "Stroke Neurology",
  "venue": "Int J Neuroscience",
  "year": "2026",
  "status": "Published",
  "doiHref": "https://www.researchgate.net/profile/Yousef-Alghzawi-2/research",
  "doiLabel": "View on ResearchGate",
  "hook": "The 4.5-hour thrombolysis window leaves many stroke patients on the wrong side of the clock. The trials that pushed past it used different doses and selection rules, and they disagree.",
  "scenario": "No single pairwise comparison could answer whether late alteplase helps and at what dose. The dosing regimens had never all met in one trial, so the comparison had to run through a network.",
  "flow": [
    {
      "k": "Clinical question",
      "v": "Beyond 4.5 hours, does alteplase still help, and does the dose matter?"
    },
    {
      "k": "The evidence",
      "v": "Late-window and wake-up stroke RCTs with inconsistent arms and doses"
    },
    {
      "k": "The design",
      "v": "One network, estimated twice: frequentist and Bayesian, with GRADE certainty on every comparison"
    },
    {
      "k": "The answer",
      "v": "Functional benefit with a quantified bleeding cost, published with certainty ratings attached"
    }
  ],
  "decisions": [
    {
      "d": "A network, because the doses never met in one trial.",
      "w": "Network meta-analysis borrows strength through shared control arms, so regimens compared only indirectly still get an estimate."
    },
    {
      "d": "The same network estimated in two frameworks.",
      "w": "The frequentist model ran in netmeta, the Bayesian model in gemtc with MCMC. When two philosophies of inference agree, the result is not an artifact of either."
    },
    {
      "d": "GRADE certainty attached to each comparison.",
      "w": "A pooled estimate without a certainty rating invites overconfidence. Clinicians got both the number and how much to trust it."
    },
    {
      "d": "Arm-level quality control before any model ran.",
      "w": "Scripted checks on every trial arm caught mislabeled arms and a double-counted trial in the source literature. The model is only as good as the network it sits on."
    }
  ],
  "problem": "Late-window thrombolysis evidence is fragmented across doses and trial designs that never met head to head.",
  "approach": "Dual-framework network meta-analysis (netmeta and gemtc MCMC) with GRADE and scripted arm-level QC.",
  "outcome": "Published in The International Journal of Neuroscience, March 2026. An independent reproduction audit later re-derived the published estimates exactly.",
  "figures": [
    {
      "src": "/assets/projects/alteplase-late/plots/netgraph.png",
      "caption": "Illustrative figure from simulated data; the real analysis stays with the journal and the clinical team."
    }
  ],
  "code": [
    {
      "id": "code-nma",
      "label": "Two frameworks, one network",
      "code": "# Frequentist side\npw  <- pairwise(treat, event = events, n = total,\n                studlab = study, data = arms, sm = \"RR\")\nnet <- netmeta(pw, random = TRUE, reference.group = \"Control\")\nnetgraph(net); netrank(net)\n\n# Bayesian side: same network, different engine\nmtc <- mtc.network(arm_data)\nmod <- mtc.model(mtc, likelihood = \"binom\", link = \"log\")\nres <- mtc.run(mod)          # MCMC\nsummary(res)\n\n# Agreement between the two frameworks is the robustness check."
    }
  ],
  "prev": {
    "slug": "lvoto-tmvr",
    "title": "Keeping the Outflow Open in TMVR"
  },
  "next": {
    "slug": "cerebrolysin",
    "title": "Cerebrolysin and the Bleeding Question"
  }
};
---
<CaseStudyLayout {...page} />
