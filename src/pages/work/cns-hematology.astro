---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const page = {
  "title": "Is a Second Transplant Worth It?",
  "description": "Survival analysis of second hematopoietic cell transplantation in lymphoma and leukemia, published in Blood.",
  "field": "Hematologic Oncology",
  "venue": "Blood (ASH)",
  "year": "2025",
  "status": "Published - First Author",
  "doiHref": "https://ashpublications.org/blood/article/146/Supplement%201/7802/555052",
  "doiLabel": "Read in Blood",
  "hook": "When leukemia or lymphoma relapses after a stem cell transplant, the hardest question in the room is whether a second transplant is worth it.",
  "scenario": "The transplant team had years of charts and no synthesized answer. My job was to turn that cohort into survival evidence a clinician can act on: who benefits, who does not, and what the procedure itself costs in mortality.",
  "flow": [
    {
      "k": "Clinical question",
      "v": "Does a second transplant extend survival, and for which patients?"
    },
    {
      "k": "The evidence",
      "v": "A single-center retrospective cohort with correlated transplant variables"
    },
    {
      "k": "The design",
      "v": "Cox modeling with collinearity and discrimination diagnostics; procedure mortality separated from disease mortality"
    },
    {
      "k": "The answer",
      "v": "Survival differs sharply by disease status at transplant; published in Blood"
    }
  ],
  "decisions": [
    {
      "d": "Collinearity screening before any hazard ratio was reported.",
      "w": "Transplant variables travel together: disease status, conditioning, donor type. Variance inflation factors decided what the Cox model could honestly hold at once."
    },
    {
      "d": "Discrimination reported alongside the model, not just p-values.",
      "w": "Harrell's C tells the reader whether the model actually separates patients who live longer from those who do not. A significant coefficient alone does not."
    },
    {
      "d": "Covariate-adjusted survival curves for the headline comparison.",
      "w": "Raw Kaplan-Meier curves compare groups that differ in more than the thing you care about. Adjusted curves compare like with like."
    },
    {
      "d": "Transplant-related mortality analyzed on its own.",
      "w": "Patients need to know whether deaths came from the procedure or the disease. Folding them together hides the answer they are really asking for."
    }
  ],
  "problem": "Relapsed lymphoma and leukemia after a first transplant, with no synthesized survival evidence for the second.",
  "approach": "Kaplan-Meier and Cox models with VIF screening, Harrell's C, adjusted curves, and a separate transplant-related mortality analysis.",
  "outcome": "Published in Blood, November 2025, first author. Mine end to end, from protocol and case report forms through the revision cycle.",
  "figures": [
    {
      "src": "/assets/projects/second-hct/plots/km_simulated.png",
      "caption": "Illustrative figure from simulated data; the real analysis stays with the journal and the clinical team."
    }
  ],
  "code": [
    {
      "id": "code-cox",
      "label": "Cox model with diagnostics",
      "code": "# Screen candidate covariates for collinearity first\ncar::vif(lm(dummy_outcome ~ disease_status + conditioning + donor_type,\n            data = cohort))\n\n# Cox model on what survives the screen\nfit <- coxph(Surv(time_months, died) ~ disease_status + age + donor_type,\n             data = cohort)\nsummary(fit)          # HRs with 95% CIs\nconcordance(fit)      # Harrell's C: does it discriminate?\n\n# Adjusted survival curves for the headline figure\nggadjustedcurves(fit, variable = \"disease_status\", data = cohort)\n\n# Transplant-related mortality, kept apart from relapse deaths\ntrm <- coxph(Surv(time_months, trm_event) ~ disease_status + age,\n             data = cohort)"
    }
  ],
  "prev": {
    "slug": "survey-analysis",
    "title": "Thirty-Four Specialists, One Whitespace Bug"
  },
  "next": {
    "slug": "sbrt-nsclc",
    "title": "Radiation or Surgery for Early Lung Cancer?"
  }
};
---
<CaseStudyLayout {...page} />
